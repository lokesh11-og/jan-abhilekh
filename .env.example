# Copy this file to .env and fill in the real value. Never commit .env.

# Supabase -> your project -> Settings -> Database -> Connection string -> URI
# Looks like: postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional — only needed for the AI Search answer summary. Search itself works without it.
ANTHROPIC_API_KEY=
